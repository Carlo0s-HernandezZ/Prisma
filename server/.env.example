# Copia este archivo como server/.env (está en .gitignore) y llena los valores.
# Las variables de entorno del sistema con el mismo nombre tienen prioridad sobre este archivo.
# NUNCA subas server/.env al repositorio: contiene llaves y contraseñas.

# ---- Entorno ----
# production (por defecto): sin trazas de error, sin correos simulados en consola, logs sin datos personales.
# development: solo para depurar en tu computadora.
PRISMA_ENV=production

# ---- HTTPS / TLS ----
HTTP_PORT=8080
HTTPS_PORT=8443
KEYSTORE_PATH=certs/prisma-keystore.p12
# Genera una con: openssl rand -base64 24
KEYSTORE_PASSWORD=

# ---- Autenticación (JWT HS256) ----
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# ---- Cifrado de datos personales en reposo (AES-256-GCM) ----
# 32 bytes en Base64. Genera una con: openssl rand -base64 32
# ¡Si la pierdes no podrás leer los datos ya cifrados!
DATA_ENCRYPTION_KEY=

# ---- Base de datos PostgreSQL ----
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/prisma_db
DB_USER=postgres
DB_PASSWORD=

# ---- API de terceros: Google Gemini (auditoría de nómina) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- API de terceros: Gmail SMTP (códigos 2FA y recuperación) ----
# Contraseña de aplicación de Google: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
