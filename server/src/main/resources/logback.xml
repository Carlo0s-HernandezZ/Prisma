<configuration>
    <!--
      Logs de producción (Actividad 3.2):
      - Nivel INFO: sin trazas de depuración ni sentencias SQL con sus valores (Exposed las escribe en DEBUG).
      - Nunca se registran contraseñas, tokens, códigos 2FA ni cuerpos de peticiones; los correos se enmascaran.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="Exposed" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
</configuration>
