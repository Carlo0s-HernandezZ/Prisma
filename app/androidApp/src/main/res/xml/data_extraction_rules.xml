<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ningún dato de la app (preferencias cifradas, base de datos, archivos) sale del
     dispositivo por respaldo en la nube ni por transferencia a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
