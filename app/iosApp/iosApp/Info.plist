<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Prisma usa Face ID para que entres a tu cuenta sin escribir tu contraseña.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Sin cargas HTTP arbitrarias: solo HTTPS. El servidor local (IP de la red) se valida con
		     Certificate Pinning en PlatformHttpClient.ios.kt. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
