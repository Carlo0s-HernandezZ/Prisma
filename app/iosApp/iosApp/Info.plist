<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- «Volver a Prisma» desde la página de Términos (prisma://abrir): solo abre la app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.prisma</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prisma</string>
			</array>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Prisma usa Face ID para que entres a tu cuenta sin escribir tu contraseña.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Sin cargas HTTP arbitrarias: solo HTTPS. El servidor local (IP de la red) se valida con
		     Certificate Pinning en PlatformHttpClient.ios.kt. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
